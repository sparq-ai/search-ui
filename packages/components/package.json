{
  "name": "@sparq/search-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/sparq.esm.js",
  "exports": {
    ".": "./dist/sparq.esm.js",
    "./auto": "./dist/sparq.esm.auto.js"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && vite build --mode iife",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "@sparq/search-core": "workspace:*",
    "@vue/reactivity": "^3.5.13",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "happy-dom": "^17.4.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  },
  "size-limit": [
    {
      "path": "dist/sparq.js",
      "limit": "70 kB",
      "gzip": true
    }
  ]
}
