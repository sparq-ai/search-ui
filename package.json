{
  "name": "sparq-search-ui-workspace",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "pnpm --filter @sparq/search-core build && pnpm --filter @sparq/search-ui build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @sparq/search-core test && pnpm --filter @sparq/search-ui test",
    "size": "pnpm --filter @sparq/search-ui size",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "lint:terminology": "node scripts/check-terminology.mjs",
    "lint:styling-docs": "node scripts/check-styling-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
